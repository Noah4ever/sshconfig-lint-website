{
  "name": "sshconfig-lint-web",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first browser playground for sshconfig-lint",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "prebuild": "node scripts/update-github-stars.mjs",
    "build": "vinext build",
    "build:coolify": "node scripts/update-github-stars.mjs && next build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.2",
    "react-server-dom-webpack": "19.2.6",
    "sass": "^1.103.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
